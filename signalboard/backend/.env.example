# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Local: sqlite is used when DATABASE_URL is empty. Render sets this for you.
DATABASE_URL=
# Your Vercel URL (no trailing slash). Used for CORS and links inside messages.
FRONTEND_URL=http://localhost:5173
SITE_NAME=Signalboard
TIME_ZONE=Asia/Kolkata

# ---------- First admin (created by: python manage.py seed_notifications) ----------
ADMIN_EMAIL=admin@signalboard.dev
ADMIN_PASSWORD=Admin@12345
# Your WhatsApp test-recipient number, digits with country code
ADMIN_PHONE=

# ---------- WhatsApp Cloud API (Meta sandbox) ----------
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
# Needed to create/sync templates from the admin panel.
# Meta > WhatsApp > API Setup > "WhatsApp Business Account ID"
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v21.0

# ---------- Email: postmark | brevo | resend | console ----------
EMAIL_PROVIDER=postmark
POSTMARKAPP_TOKEN=your_server_token
POSTMARK_FROM_EMAIL=your_verified_email@example.com
POSTMARK_MESSAGE_STREAM=outbound
# If you switch to Brevo:
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# If you switch to Resend:
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------- Web Push (OneSignal free) ----------
ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_REST_API_KEY=your_api_key

# ---------- Misc ----------
NOTIFY_ASYNC=True
# Secret for POST /api/cron/inactivity/ (header X-Cron-Secret)
CRON_SECRET=change-me
